<?xml version="1.0" encoding="utf-8"?>
<!-- Fluid's page is built into the app. The app reaches the internet only for an AI the teacher chooses, over HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
